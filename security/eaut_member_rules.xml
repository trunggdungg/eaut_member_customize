<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Khách truy cập / portal chỉ thấy nội dung đã xuất bản -->
    <record id="rule_eaut_member_public" model="ir.rule">
        <field name="name">Hội viên: khách chỉ xem hội viên đã xuất bản</field>
        <field name="model_id" ref="model_eaut_member"/>
        <field name="domain_force">[('website_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_eaut_member_product_public" model="ir.rule">
        <field name="name">Sản phẩm hội viên: khách chỉ xem nội dung đã xuất bản</field>
        <field name="model_id" ref="model_eaut_member_product"/>
        <field name="domain_force">[('is_published', '=', True), ('member_id.website_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_eaut_member_service_public" model="ir.rule">
        <field name="name">Dịch vụ hội viên: khách chỉ xem nội dung đã xuất bản</field>
        <field name="model_id" ref="model_eaut_member_service"/>
        <field name="domain_force">[('is_published', '=', True), ('member_id.website_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_eaut_member_gallery_public" model="ir.rule">
        <field name="name">Thư viện ảnh hội viên: khách chỉ xem nội dung đã xuất bản</field>
        <field name="model_id" ref="model_eaut_member_gallery"/>
        <field name="domain_force">[('is_published', '=', True), ('member_id.website_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_eaut_member_post_public" model="ir.rule">
        <field name="name">Bài viết hội viên: khách chỉ xem nội dung đã xuất bản</field>
        <field name="model_id" ref="model_eaut_member_post"/>
        <field name="domain_force">[('is_published', '=', True), ('member_id.website_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
    </record>
</odoo>
