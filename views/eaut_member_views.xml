<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ngành nghề -->
    <record id="view_eaut_member_industry_list" model="ir.ui.view">
        <field name="name">eaut.member.industry.list</field>
        <field name="model">eaut.member.industry</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="member_count"/>
            </list>
        </field>
    </record>

    <record id="action_eaut_member_industry" model="ir.actions.act_window">
        <field name="name">Ngành nghề</field>
        <field name="res_model">eaut.member.industry</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Hội viên -->
    <record id="view_eaut_member_list" model="ir.ui.view">
        <field name="name">eaut.member.list</field>
        <field name="model">eaut.member</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="industry_id"/>
                <field name="representative_name"/>
                <field name="representative_position"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="website_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_member_kanban" model="ir.ui.view">
        <field name="name">eaut.member.kanban</field>
        <field name="model">eaut.member</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="industry_id"/>
                <field name="representative_name"/>
                <field name="website_published"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex gap-3">
                            <field name="logo" widget="image" options="{'preview_image': 'logo'}" class="o_image_64_contain"/>
                            <div class="flex-grow-1">
                                <field name="name" class="fw-bold fs-5"/>
                                <div t-if="record.industry_id.raw_value"><field name="industry_id"/></div>
                                <div t-if="record.representative_name.raw_value" class="text-muted"><field name="representative_name"/></div>
                                <span t-if="record.website_published.raw_value" class="badge text-bg-success mt-1">Đã xuất bản</span>
                                <span t-else="" class="badge text-bg-secondary mt-1">Chưa xuất bản</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_eaut_member_search" model="ir.ui.view">
        <field name="name">eaut.member.search</field>
        <field name="model">eaut.member</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Hội viên" filter_domain="['|', ('name', 'ilike', self), ('representative_name', 'ilike', self)]"/>
                <field name="industry_id"/>
                <filter name="published" string="Đã xuất bản" domain="[('website_published', '=', True)]"/>
                <filter name="unpublished" string="Chưa xuất bản" domain="[('website_published', '=', False)]"/>
                <filter name="archived" string="Đã lưu trữ" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_industry" string="Ngành nghề" context="{'group_by': 'industry_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_eaut_member_form" model="ir.ui.view">
        <field name="name">eaut.member.form</field>
        <field name="model">eaut.member</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="website_url" invisible="1"/>
                        <field name="website_published" widget="website_redirect_button"/>
                    </div>
                    <widget name="web_ribbon" title="Lưu trữ" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên công ty"/></h1>
                    </div>
                    <group>
                        <group string="Thông tin chung">
                            <field name="industry_id"/>
                            <field name="representative_name"/>
                            <field name="representative_position"/>
                            <field name="join_date"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Liên hệ">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="website"/>
                            <field name="address"/>
                            <field name="website_published" string="Xuất bản" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Giới thiệu" name="intro">
                            <group>
                                <field name="banner" widget="image" options="{'size': [0, 120]}"/>
                                <field name="short_description"/>
                            </group>
                            <field name="description"/>
                        </page>
                        <page string="Sản phẩm" name="products">
                            <field name="product_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [0, 48]}"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="is_published" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Dịch vụ" name="services">
                            <field name="service_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [0, 48]}"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="is_published" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bài viết" name="posts">
                            <field name="post_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="publish_date"/>
                                    <field name="is_published" widget="boolean_toggle"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="title"/>
                                            <field name="publish_date"/>
                                            <field name="is_published"/>
                                            <field name="cover" widget="image" options="{'size': [0, 120]}"/>
                                            <field name="summary"/>
                                        </group>
                                        <field name="content"/>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Thư viện ảnh" name="gallery">
                            <field name="gallery_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [0, 48]}"/>
                                    <field name="name"/>
                                    <field name="is_published" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Yêu cầu liên hệ" name="contact_requests">
                            <field name="contact_request_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_eaut_member" model="ir.actions.act_window">
        <field name="name">Hội viên</field>
        <field name="res_model">eaut.member</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_eaut_member_search"/>
    </record>

    <!-- Yêu cầu liên hệ -->
    <record id="view_eaut_member_contact_request_list" model="ir.ui.view">
        <field name="name">eaut.member.contact.request.list</field>
        <field name="model">eaut.member.contact.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="member_id"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_eaut_member_contact_request_form" model="ir.ui.view">
        <field name="name">eaut.member.contact.request.form</field>
        <field name="model">eaut.member.contact.request</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="member_id"/>
                        <field name="name"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_eaut_member_contact_request" model="ir.actions.act_window">
        <field name="name">Yêu cầu liên hệ</field>
        <field name="res_model">eaut.member.contact.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
